# --- Login con Google (NextAuth) ---
# Credenciales OAuth tipo "Aplicación web" creadas en Google Cloud Console.
# Solo se piden los scopes básicos (email, perfil): no sensibles, sin aviso de
# "app no verificada" ni límite de usuarios de prueba.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Cuenta de servicio de Google (acceso de backend a Sheets) ---
# El login de cada vecino NO necesita permisos sobre Sheets/Drive: solo el
# backend accede a la hoja, usando esta cuenta de servicio compartida como
# editora de la hoja de cálculo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Vercel Blob (fotos/PDF adjuntos a incidencias) ---
BLOB_READ_WRITE_TOKEN=
